# Postgres (rol de SOLO LECTURA, GRANT SELECT únicamente sobre
# ordenes, facturas, detalle_documento, clientes, productos)
MCP_DB_HOST=dashboard_postgres
MCP_DB_PORT=5432
MCP_DB_NAME=ventas_mv
MCP_DB_USER=mcp_readonly
MCP_DB_PASS=

# Puerto HTTP interno del servidor MCP (NPM hace el forward hacia este puerto,
# no se publica al host)
PORT=8787

# OAuth con Google (paso 2 — todavía no se usa en el paso 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_HD=aqua.com.ec
MCP_JWT_SECRET=
