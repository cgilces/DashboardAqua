# Postgres — datos de ventas (rol de SOLO LECTURA, GRANT SELECT únicamente
# sobre ordenes, facturas, detalle_documento, clientes, productos)
MCP_DB_HOST=dashboard_postgres
MCP_DB_PORT=5432
MCP_DB_NAME=ventas_mv
MCP_DB_USER=mcp_readonly
MCP_DB_PASS=

# Puerto HTTP interno del servidor MCP (NPM hace el forward hacia este puerto,
# no se publica al host)
PORT=8787

# URL pública de este servidor (issuer OAuth + resource server). En local:
# http://localhost:8787 (el SDK permite HTTP solo para localhost/127.0.0.1).
# En producción: https://mcp.aqua.com.ec (obligatorio HTTPS).
MCP_ISSUER_URL=http://localhost:8787

# OAuth con Google ("Sign in with Google"). Crear un OAuth Client ID tipo
# "Web application" en Google Cloud Console, con como Authorized redirect URI
# exactamente "<MCP_ISSUER_URL>/oauth/google/callback".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dominio de Google Workspace exigido en el claim `hd` del id_token — cualquier
# otra cuenta de Google (aunque el login sea válido) se rechaza explícitamente.
ALLOWED_HD=aqua.com.ec

# Secreto de firma de los access tokens propios (JWT, vida corta ~1h).
# Generar con: openssl rand -hex 32
MCP_JWT_SECRET=

# Postgres — estado de OAuth (clientes registrados, refresh tokens, log de
# logins). Rol separado `mcp_oauth`, con permisos acotados SOLO al esquema
# mcp_oauth — no tiene ningún acceso a las tablas de ventas.
MCP_OAUTH_DB_HOST=dashboard_postgres
MCP_OAUTH_DB_PORT=5432
MCP_OAUTH_DB_NAME=ventas_mv
MCP_OAUTH_DB_USER=mcp_oauth
MCP_OAUTH_DB_PASS=
